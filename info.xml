<?xml version="1.0"?>
<extension key="moeve_crewing" type="module">
  <file>moeve_crewing</file>
  <name>M&#xF6;we Crewing</name>
  <description>Unterst&#xFC;tzt die Planung von Besatzungen, Rollen und Qualifikationen f&#xFC;r Veranstaltungen und T&#xF6;rns der Thor Heyerdahl.</description>
  <license>AGPL-3.0</license>
  <authors>
    <author>
      <name>Jannik Rathke</name>
      <email>Jannik.Rathke@posteo.de</email>
      <role>Maintainer</role>
    </author>
  </authors>
  <urls>
    <url desc="Main Extension Page">https://github.com/Jannik-Rathke/moeve-sandbox</url>
    <url desc="Documentation">https://github.com/Jannik-Rathke/moeve-sandbox</url>
    <url desc="Support">https://github.com/Jannik-Rathke/moeve-sandbox/issues</url>
    <url desc="Licensing">https://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-09-17</releaseDate>
  <version>0.1.0</version>
  <develStage>alpha</develStage>
  <compatibility mode="semver">
    <comments>Semantic versioning. For example, compatibility with "6.1" implies compatibility with "6.2".</comments>
    <ver>6.17</ver>
  </compatibility>
  <php_compatibility mode="list">
    <comments>Listed versions. For example, specify both "8.1" and "8.2".</comments>
    <ver>8.0</ver>
    <ver>8.1</ver>
    <ver>8.2</ver>
    <ver>8.3</ver>
    <ver>8.4</ver>
  </php_compatibility>
  <smarty_compatibility mode="list">
    <comments>Listed versions. For example, specify both "4" and "5".</comments>
    <ver>5</ver>
  </smarty_compatibility>
  <comments>Alpha-Version f&#xFC;r die schrittweise Entwicklung der M&#xF6;we-Crewing-Funktionen.</comments>
  <requires>
    <ext>civi_event</ext>
  </requires>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <civix>
    <namespace>CRM/MoeveCrewing</namespace>
    <format>25.10.2</format>
    <angularModule>crmMoeveCrewing</angularModule>
  </civix>
  <mixins>
    <mixin>mgd-php@2.0.0</mixin>
    <mixin>scan-classes@1.0.0</mixin>
    <mixin>setting-php@1.0.0</mixin>
    <mixin>smarty@1.0.3</mixin>
    <mixin>menu-xml@1.0.0</mixin>
  </mixins>
</extension>
